#include <stdio.h>

int main() {
    int L, N;
    int W, H;

    if (scanf("%d", &L) != 1) return 0;

    if (scanf("%d", &N) != 1) return 0;

    for (int i = 0; i < N; i++) {
        scanf("%d %d", &W, &H);

        if (W < L || H < L) {
            printf("UPLOAD ANOTHER\n");
        }
        
        else {
            
            if (W == H) {
                printf("ACCEPTED\n");
            } 
            
            else {
                printf("CROP IT\n");
            }
        }
    }

    return 0;
}
